/* ============================================
   PLUMB - DARK THEME
   ============================================ */

$background: #0a0a0a;
$surface: #141414;
$surface-elevated: #1e1e1e;
$terminal-bg: #0a0a0a;

$primary-text: #d4d4d4;
$text-muted: #808080;
$text-dim: #505050;

$splash-logo: #569cd6;
$accent: #c586c0;
$accent-hover: #d4a8d0;
$hover-secondary: #808080;

$success: #4ec9b0;
$warning: #dcdcaa;
$error: #f44747;

$border: #333333;
$border-focused: #c586c0;

/* Base */
Screen {
    background: $background;
    color: $primary-text;
}

.screen--selection {
    background: #264f78;
    color: #ffffff;
    text-style: none;
}

.screen--selection #output {
    background: #264f78;
}

Container {
    background: $background;
}

/* Header */
Header {
    background: $surface;
    color: $primary-text;
    dock: top;
    height: 1;
}

/* Footer */
Footer {
    background: $surface;
    color: $text-muted;
    dock: bottom;
    height: 1;
}

Footer .key {
    color: $accent;
    text-style: bold;
}

/* ===== SPLASH SCREEN ===== */
#splash-container {
    width: 100%;
    height: 100%;
    content-align: center middle;
    background: $background;
    layout: vertical;
}

#logo {
    text-style: bold;
    color: $splash-logo;
    content-align: center middle;
    text-align: center;
}

#developer {
    color: $text-muted;
    content-align: center middle;
    text-align: center;
    margin-top: 1;
}

/* ===== MAIN LAYOUT ===== */
#main-layout {
    width: 100%;
    height: 1fr;
    layout: horizontal;
}

/* Left pane */
#main-pane {
    width: 3fr;
    height: 100%;
    layout: vertical;
    background: $background;
}

/* Output console */
#output {
    height: 1fr;
    background: #0a0a0a;
    background-tint: transparent;
    border: tall $border;
    min-height: 3;
    color: $primary-text;
    padding-left: 1;
    scrollbar-size: 1 1;
    scrollbar-color: $accent;
    scrollbar-color-hover: $accent-hover;
}

#output:focus {
    background: transparent;
}

#output .selection-active {
    text-style: reverse;
}

/* Spinner */
#spinner {
    height: 1;
    background: #0a0a0a;
    color: $accent;
    padding: 0 1;
}

/* Input bar */
#input-bar {
    height: auto;
    min-height: 3;
    max-height: 8;
    background: #1e1e1e;
    layout: horizontal;
    padding: 0 1;
}

#input-bar TextArea {
    width: 1fr;
    height: auto;
    min-height: 3;
    max-height: 6;
    background: #1e1e1e;
    color: $primary-text;
    border: tall $border;
    padding: 0 1;
}

#input-bar TextArea:focus {
    border: tall $border-focused;
}

/* Send button */
#send {
    width: 14;
    height: auto;
    min-height: 3;
    margin-left: 1;
    background: #1f6feb;
    color: #ffffff;
    border: double #58a6ff;
    text-style: bold reverse;
}

#send:hover {
    background: #388bfd;
    border: double #79c0ff;
}

/* Right sidebar */
#sidebar {
    width: 1fr;
    height: 100%;
    background: $surface;
    border-left: tall $border;
    layout: vertical;
    padding: 1;
}

#sidebar-content {
    height: 1fr;
    overflow-y: auto;
}

#sidebar-footer {
    height: auto;
    border-top: solid $border;
    padding-top: 1;
}

/* Heading */
#heading {
    height: auto;
    min-height: 1;
    margin-bottom: 1;
    margin-top: 1;
    padding: 0 1;
    color: $primary-text;
    text-style: bold;
    content-align: left middle;
}

/* Context info */
#context-info {
    height: auto;
    min-height: 1;
    margin-bottom: 1;
    padding: 0 1;
    color: $text-muted;
    content-align: left middle;
}

/* Task list */
#task-list {
    height: auto;
    min-height: 1;
    margin-bottom: 1;
    padding: 0 1;
    color: $text-muted;
    content-align: left middle;
}

/* Thinking level */
#thinking-level {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text-muted;
    content-align: left middle;
}

/* LLM Status */
#llm-status {
    height: 1;
    margin-bottom: 0;
    padding: 0 1;
    color: $text-muted;
    content-align: left middle;
}

#llm-status.online {
    color: $success;
}

#llm-status.offline {
    color: $error;
}

/* Developer credit */
#developer {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    color: $text-muted;
    content-align: left middle;
}

/* Session ID */
#session-id-display {
    height: 1;
    padding: 0 1;
    color: $text-dim;
    content-align: left middle;
}

/* Model name */
#model-name {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    padding: 0 1;
    background: $accent;
    color: $background;
    text-style: bold;
    content-align: left middle;
    border: tall $accent;
}

#model-name.clickable:hover {
    background: $accent-hover;
}

/* Model list */
#model-list {
    height: auto;
    max-height: 30%;
    background: $surface-elevated;
    border: tall $border;
    overflow-y: auto;
    margin-bottom: 1;
}

#model-list.hidden {
    display: none;
}

#model-list > * {
    background: transparent;
    color: $text-muted;
    padding: 0 1;
}

#model-list > *:hover {
    background: $surface;
    color: $primary-text;
}

#model-list ListItem {
    height: auto;
    min-height: 1;
}

/* Generic Button */
Button {
    background: $accent;
    color: $primary-text;
    border: tall $accent;
    text-style: bold;
}

Button:hover {
    background: $accent-hover;
    border: tall $accent-hover;
}

/* Scrollbar */
Scrollbar {
    background: $surface;
}

Scrollbar .slider {
    background: $border;
}

Scrollbar .slider:hover {
    background: $accent;
}

/* Label */
Label {
    color: $text-muted;
}
